# Copy to .env and supply your real OpenAI key (never commit .env)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-astra
# Optional: set USE_FAKE_MODEL=1 to run the UI offline without calling OpenAI
USE_FAKE_MODEL=0
# Optional: override SQLite database path
DATABASE_PATH=mission_control.db
